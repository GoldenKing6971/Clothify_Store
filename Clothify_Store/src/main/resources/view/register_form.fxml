   <PasswordField fx:id="txtCPassword" layoutX="83.0" layoutY="307.0" promptText="Confirm Password" styleClass="text-field" />
   <PasswordField fx:id="txtPassword" layoutX="83.0" layoutY="245.0" promptText="Password" styleClass="text-field" />
   <TextField fx:id="txtEmail" layoutX="83.0" layoutY="181.0" promptText="Email" styleClass="text-field" />
   <TextField fx:id="txtUserName" layoutX="83.0" layoutY="116.0" promptText="User Name" styleClass="text-field" />
   <Label layoutX="145.0" layoutY="28.0" prefHeight="59.0" prefWidth="113.0" style="-fx-text-fill: #8a2387;" text="Register" textFill="WHITE">
      <font>
         <Font name="System Bold" size="26.0" />
      </font>
   </Label>
